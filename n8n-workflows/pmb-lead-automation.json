            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.whatsapp }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"Halo {{ $json.full_name }}, kuota beasiswa jalur awal untuk jurusan *{{ $json.program_study }}* tersisa 3 slot lagi nih! 🎓\\n\\nSelesaikan tahap registrasimu hari ini agar beasiswamu tidak hangus: https://akademiskill.ac.id/bayar-registrasi?id={{ $json.lead_id }}\"\n  }\n}"
      },
      "id": "8",
      "name": "Kirim WA Nurturing / Anti-Leak",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1420, 260]
    }
