{
  "name": "PMB Lead Nurturing & Anti-Leak Automation - Akademi Skill Nusantara",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pmb-lead",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "id": "1",
      "name": "Webhook - PMB Form Submitted",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [220, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "lead_id",
              "value": "={{ $json.body.lead_id || 'LD-' + Date.now() }}"
            },
            {
              "name": "full_name",
              "value": "={{ $json.body.full_name }}"
            },
            {
              "name": "whatsapp",
              "value": "={{ $json.body.whatsapp }}"
            },
            {
              "name": "email",
              "value": "={{ $json.body.email }}"
            },
            {
              "name": "program_study",
              "value": "={{ $json.body.program_study }}"
            },
            {
              "name": "utm_source",
              "value": "={{ $json.body.utm_source || 'Instagram Ads' }}"
            },
            {
              "name": "status",
              "value": "Form Submitted"
            }
          ]
        },
        "options": {}
      },
      "id": "2",
      "name": "Set Lead Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.whatsapp.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_WA_BUSINESS_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.whatsapp }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"Halo {{ $json.full_name }}! 👋\\n\\nTerima kasih telah mendaftar di program *{{ $json.program_study }}* di Akademi Skill Nusantara.\\n\\n📥 Unduh brosur resmi & rincian biaya: https://akademiskill.ac.id/brosur-2026.pdf\\n\\nAda pertanyaan? Langsung balas pesan ini untuk terhubung dengan konselor PMB kami!\"\n  }\n}"
      },
      "id": "3",
      "name": "Instant WhatsApp Auto-Response (Siswa)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [700, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/botYOUR_TELEGRAM_BOT_TOKEN/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"@pak_hendra_admission_alert\",\n  \"text\": \"🚨 *LEAD BARU PMB MASUK!*\\n\\n👤 *Nama:* {{ $json.full_name }}\\n📱 *WhatsApp:* {{ $json.whatsapp }}\\n📧 *Email:* {{ $json.email }}\\n🎓 *Prodi:* {{ $json.program_study }}\\n🎯 *Campaign:* {{ $json.utm_source }}\\n⏰ *Waktu:* {{ $now.format('yyyy-MM-dd HH:mm:ss') }}\\n\\n_Data otomatis tersinkronisasi ke Dashboard LeakTrace._\",\n  \"parse_mode\": \"Markdown\"\n}"
      },
      "id": "4",
      "name": "Alert Real-time ke Pak Hendra (Telegram)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [700, 340]
    },
    {
      "parameters": {
        "operation": "append",
        "sheetId": "1aBcDeFgHiJkLmNoPqRsTuVwXyZ",
        "range": "PMB_Leads!A:G",
        "options": {}
      },
      "id": "5",
      "name": "Sync Data ke Google Sheets / DB",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 2,
      "position": [700, 500]
    },
    {
      "parameters": {
        "amount": 24,
        "unit": "hours"
      },
      "id": "6",
      "name": "Wait 24 Jam (Anti-Leak Follow-Up)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [960, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equal",
              "value2": "Form Submitted"
            }
          ]
        }
      },
      "id": "7",
      "name": "Cek: Masih Macet di Isi Form?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1180, 300]
    },
    {
